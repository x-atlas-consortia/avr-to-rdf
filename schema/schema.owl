avro:target_symbol a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "target_symbol" ;
    dcterms:title "target symbol" ;
    skos:definition "Gene symbol (HGNC) of the antibody target." ;
    skos:inScheme <https://purl.humanatlas.io/schema/avr> .

avro:taxon a owl:ObjectProperty,
