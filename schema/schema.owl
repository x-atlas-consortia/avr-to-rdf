avro:AntibodyValidationReportCollection a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "AntibodyValidationReportCollection" ;
    dcterms:title "Antibody Validation Report Collection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty avro:antibodies ],
        [ a owl:Restriction ;
            owl:allValuesFrom avro:Antibody ;
            owl:onProperty avro:antibodies ] ;
    skos:definition "A collection of Antibody Validation Reports." ;
    skos:exactMatch avro:AntibodyValidationReportCollection ;
    skos:inScheme <https://purl.humanatlas.io/schema/avr> .

