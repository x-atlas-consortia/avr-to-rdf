avro:antibodies a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "antibodies" ;
    dcterms:title "antibodies" ;
    skos:definition "List of antibodies in this collection." ;
    skos:inScheme <https://purl.humanatlas.io/schema/avr> .

avro:author_orcids a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "author_orcids" ;
    dcterms:title "author ORCIDs" ;
    skos:definition "ORCID(s) of the author(s)." ;
    skos:inScheme <https://purl.humanatlas.io/schema/avr> .

