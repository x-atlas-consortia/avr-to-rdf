    skos:inScheme <https://purl.humanatlas.io/schema/avr> .

avro:ClonalityEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "ClonalityEnum" ;
    owl:unionOf ( <https://purl.humanatlas.io/schema/avr#ClonalityEnum#monoclonal> <https://purl.humanatlas.io/schema/avr#ClonalityEnum#polyclonal> ) ;
    skos:definition "Clonality of antibody." ;
    skos:inScheme <https://purl.humanatlas.io/schema/avr> ;
    linkml:permissible_values <https://purl.humanatlas.io/schema/avr#ClonalityEnum#monoclonal>,
        <https://purl.humanatlas.io/schema/avr#ClonalityEnum#polyclonal> .

avro:ResourceIdentifier a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf linkml:Uriorcurie .

avro:HostOrganism a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "HostOrganism" ;
    owl:unionOf ( <https://purl.humanatlas.io/schema/avr#HostOrganism#Mouse> <https://purl.humanatlas.io/schema/avr#HostOrganism#Rabbit> <https://purl.humanatlas.io/schema/avr#HostOrganism#Goat> <https://purl.humanatlas.io/schema/avr#HostOrganism#Human> <https://purl.humanatlas.io/schema/avr#HostOrganism#Chicken> <https://purl.humanatlas.io/schema/avr#HostOrganism#Sheep> ) ;
    skos:definition "Host organism for antibody generation." ;
    skos:inScheme <https://purl.humanatlas.io/schema/avr> ;
    linkml:permissible_values <https://purl.humanatlas.io/schema/avr#HostOrganism#Chicken>,
        <https://purl.humanatlas.io/schema/avr#HostOrganism#Goat>,
        <https://purl.humanatlas.io/schema/avr#HostOrganism#Human>,
        <https://purl.humanatlas.io/schema/avr#HostOrganism#Mouse>,
        <https://purl.humanatlas.io/schema/avr#HostOrganism#Rabbit>,
        <https://purl.humanatlas.io/schema/avr#HostOrganism#Sheep> .

<https://purl.humanatlas.io/schema/avr> a owl:Ontology ;
    rdfs:label "avro" ;
    dcterms:title "Antibody Validation Report (AVR) Application Ontology" ;
    skos:definition "LinkML schema for Antibody Validation Report (AVR) data." .

