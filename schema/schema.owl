<https://purl.humanatlas.io/schema/avr#ClonalityEnum#monoclonal> a owl:Class,
        avro:ClonalityEnum ;
    rdfs:label "monoclonal" ;
    rdfs:subClassOf avro:ClonalityEnum ;
    skos:definition "Monoclonal antibody." .

<https://purl.humanatlas.io/schema/avr#ClonalityEnum#polyclonal> a owl:Class,
        avro:ClonalityEnum ;
    rdfs:label "polyclonal" ;
    rdfs:subClassOf avro:ClonalityEnum ;
    skos:definition "Polyclonal antibody." .

