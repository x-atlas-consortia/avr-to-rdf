avro:omap a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "omap" ;
    dcterms:title "OMAP identifier" ;
    skos:definition "OMAP (organ mapping anatomical project) identifier string, such as OMAP-14." ;
