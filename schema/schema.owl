avro:omap_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "omap_id" ;
    dcterms:title "OMAP PURL" ;
    skos:definition "Canonical versionless OMAP PURL resolved from the OMAP identifier." ;
