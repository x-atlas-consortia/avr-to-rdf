avro:method a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "method" ;
    dcterms:title "method" ;
    skos:definition "Analytical method used in validation." ;
    skos:inScheme <https://purl.humanatlas.io/schema/avr> .

avro:next_version_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "next_version_id" ;
    dcterms:title "next version identifier" ;
    skos:definition "Identifier of next version if this has been superseded." ;
