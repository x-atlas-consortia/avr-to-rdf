avro:recombinant a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "recombinant" ;
    dcterms:title "recombinant" ;
    skos:definition "Whether the antibody is recombinant." ;
    skos:inScheme <https://purl.humanatlas.io/schema/avr> .

avro:recommended a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "recommended" ;
    dcterms:title "recommended" ;
    skos:definition "Whether this antibody is recommended for use." ;
    skos:inScheme <https://purl.humanatlas.io/schema/avr> .

avro:rrid a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rrid" ;
    dcterms:title "RRID" ;
